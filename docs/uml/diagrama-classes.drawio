            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-156" edge="1" parent="1" source="p2-137" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.131;exitDx=0;exitDy=0;entryX=0;entryY=0.857;entryDx=0;entryDy=0;endArrow=open;endSize=10;endFill=0;" target="p2-147" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="4131" y="2445" />
              <mxPoint x="4131" y="1728.825" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-157" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#fffde7;strokeColor=#999999;fontSize=11;" value="&lt;b&gt;MVC&lt;/b&gt;&lt;br&gt;Cada View (JPanel) recebe pelo construtor apenas a &lt;i&gt;interface&lt;/i&gt; do seu controller (injeção feita no Main) e não tem regra de negócio nem SQL: lê os campos, chama o controller e exibe o resultado ou a exceção em JOptionPane. A TelaPrincipal (JFrame) organiza as 5 telas em abas e mostra as notificações. O Model não conhece View nem Controller: a MatriculaView só é avisada porque implementa MatriculaObserver." vertex="1">
          <mxGeometry height="200" width="640" x="40" y="2771" as="geometry" />
        </mxCell>
        <mxCell id="p2-158" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#fffde7;strokeColor=#999999;fontSize=11;" value="&lt;b&gt;Controllers (camada de aplicação)&lt;/b&gt;&lt;br&gt;Concentram as regras que envolvem mais de uma classe: buscam dados nos DAOs, validam (ex.: matrícula ativa existente, acesso na catraca), escolhem a Strategy, usam as Factories e registram os Observers. Além do DAO principal, recebem pelo construtor os DAOs auxiliares (setas no diagrama), os Observers e a TreinoFactory (listados nos atributos). Não há Facade nem Service separados: a interface de cada controller já é a porta de entrada simples da View, e uma camada a mais só repassaria as chamadas." vertex="1">
          <mxGeometry height="200" width="640" x="700" y="2771" as="geometry" />
        </mxCell>
        <mxCell id="p2-159" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#fffde7;strokeColor=#999999;fontSize=11;" value="&lt;b&gt;Persistência&lt;/b&gt;&lt;br&gt;Cada entidade tem um contrato DAO (interface) e uma implementação SQLite (DAOImpl). Controllers e DAOImpls dependem só das interfaces DAO (ex.: MatriculaDAOImpl recebe AlunoDAO e PlanoDAO para montar a Matricula). Salvamentos com mais de uma tabela (aluno + restricoes_medicas, treino + treino_exercicios) usam transação com commit/rollback." vertex="1">
          <mxGeometry height="200" width="640" x="1360" y="2771" as="geometry" />
        </mxCell>
        <mxCell id="p2-160" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#fffde7;strokeColor=#999999;fontSize=11;" value="&lt;b&gt;Singleton e seed&lt;/b&gt;&lt;br&gt;ConnectionFactory tem construtor privado e getInstancia(): uma única configuração de acesso ao academia.db, que cria as tabelas (DDL) na primeira execução. criarParaTestes() (pacote) gera bancos temporários nos testes. O Main cadastra os planos padrão e a DadosDemonstracao cadastra dados de exemplo pelos controllers apenas quando o banco não tem alunos." vertex="1">
          <mxGeometry height="200" width="640" x="2020" y="2771" as="geometry" />
        </mxCell>
        <mxCell id="eGiNEkoB0eN3XM-7XPA1-8" edge="1" parent="1" source="p2-78" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=open;endSize=10;endFill=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" target="p2-63" value="">
