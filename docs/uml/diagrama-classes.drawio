        <mxCell id="p2-153" connectable="0" parent="p2-152" style="edgeLabel;resizable=0;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=none;align=right;verticalAlign=bottom;" value="1" vertex="1">
          <mxGeometry relative="1" x="1" as="geometry">
            <mxPoint x="-8" y="23" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-154" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#fffde7;strokeColor=#999999;fontSize=11;" value="&lt;b&gt;MVC:&lt;/b&gt;&amp;nbsp;as Views conhecem apenas as &lt;i&gt;interfaces&lt;/i&gt; de controller, recebidas no construtor (injeção de dependência feita no Main). Controllers aplicam as regras de negócio e usam os DAOs; a View nunca acessa o DAO. O Model não conhece View nem Controller: a MatriculaView só recebe avisos porque implementa MatriculaObserver." vertex="1">
          <mxGeometry height="150" width="620" x="40" y="1581" as="geometry" />
        </mxCell>
        <mxCell id="p2-155" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#fffde7;strokeColor=#999999;fontSize=11;" value="&lt;b&gt;Persistência:&lt;/b&gt;&amp;nbsp;cada entidade tem uma interface DAO (contrato) e uma implementação SQLite. Controllers dependem só das interfaces, então trocar SQLite por arquivo ou outro banco não muda nenhum controller. Os DAOs também usam as classes do model (página 1)." vertex="1">
          <mxGeometry height="150" width="620" x="680" y="1581" as="geometry" />
        </mxCell>
        <mxCell id="p2-156" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#fffde7;strokeColor=#999999;fontSize=11;" value="&lt;b&gt;Singleton:&amp;nbsp;&lt;/b&gt;ConnectionFactory tem construtor privado e um único ponto de acesso (getInstancia()). Garante uma única configuração de conexão com o SQLite e cria as tabelas (DDL) na primeira inicialização." vertex="1">
          <mxGeometry height="150" width="560" x="1320" y="1581" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
