        </mxCell>
        <mxCell id="p1-111" edge="1" parent="1" source="p1-69" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;endArrow=block;endSize=14;endFill=0;" target="p1-59" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-112" edge="1" parent="1" source="p1-63" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;endArrow=block;endSize=14;endFill=0;" target="p1-60" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-113" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#fffde7;strokeColor=#999999;fontSize=11;" value="&lt;b&gt;Strategy:&lt;/b&gt;&amp;nbsp;Matricula delega o cálculo da mensalidade a uma CalculoMensalidadeStrategy. A regra (padrão, estudante, idoso) pode ser trocada em tempo de execução com alterarCalculo(), sem alterar a classe Matricula." vertex="1">
          <mxGeometry height="120" width="420" x="40" y="1784" as="geometry" />
        </mxCell>
        <mxCell id="p1-114" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#fffde7;strokeColor=#999999;fontSize=11;" value="&lt;b&gt;Observer:&lt;/b&gt;&amp;nbsp;Matricula é o sujeito. Quando o status muda (vence, é cancelada ou renovada), notifica todos os MatriculaObserver registrados (log, tela). Matricula não conhece as classes concretas dos observadores." vertex="1">
          <mxGeometry height="120" width="420" x="480" y="1784" as="geometry" />
        </mxCell>
        <mxCell id="p1-115" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#fffde7;strokeColor=#999999;fontSize=11;" value="&lt;b&gt;Factory:&lt;/b&gt;&amp;nbsp;PlanoFactory centraliza a criação dos planos padrão a partir do TipoPlano (duração e valor de cada um). O resto do sistema não usa new Plano(...) diretamente." vertex="1">
          <mxGeometry height="120" width="420" x="920" y="1784" as="geometry" />
        </mxCell>
        <mxCell id="p1-116" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#fffde7;strokeColor=#999999;fontSize=11;" value="&lt;b&gt;Exceções:&lt;/b&gt;&amp;nbsp;Pessoa lança CpfInvalidoException ao validar o CPF; o modelo lança DadosInvalidosException para dados inválidos; Frequencia lança AcessoNegadoException se a matrícula não estiver ativa; o controller lança MatriculaAtivaExistenteException se o aluno já tiver matrícula ativa. Todas são tratadas na camada de controller/view." vertex="1">
          <mxGeometry height="120" width="520" x="1360" y="1784" as="geometry" />
        </mxCell>
        <mxCell id="p1-117" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#fffde7;strokeColor=#999999;fontSize=11;" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;Azul: model.entities; Amarelo: model.enums&lt;br&gt;Verde: patterns.strategy; Roxo: patterns.observer&lt;br&gt;Laranja: patterns.factory; Vermelho: exception&lt;br&gt;Sublinhado = static; Itálico = abstrato&lt;br&gt;Seta cheia vazada = herança; Tracejada vazada = implementa (realização)&lt;br&gt;Seta aberta = associação; Tracejada aberta = dependência" vertex="1">
          <mxGeometry height="160" width="600" x="2257" y="520" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
